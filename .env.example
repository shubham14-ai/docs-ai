# ---------------------------------------------------------------------------
# Document Insights API — configuration
# Copy to .env and adjust. Every value below is read by app/config.py.
# No connection string is ever hardcoded in the source.
# ---------------------------------------------------------------------------

# --- Dependencies ----------------------------------------------------------
# Inside docker compose the hostnames are the service names.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=document_insights
# Host port the Mongo container is published on, for Compass/mongosh from
# outside docker. Not 27017: a native mongod on the host commonly owns that
# port, and the client silently connects to it instead.
MONGODB_HOST_PORT=27018
REDIS_URL=redis://redis:6379/0
# Socket timeout for ordinary Redis commands. The worker derives a longer one
# for its blocking stream read.
REDIS_SOCKET_TIMEOUT=5

# --- Rate limiting ---------------------------------------------------------
# Max documents a single user may hold in queued+processing at once (429 above).
MAX_ACTIVE_DOCS_PER_USER=3
# TTL on the Redis counter key. Long enough to outlive any job, short enough
# that abandoned keys expire. The sweeper reconciles drift from MongoDB anyway.
RATE_LIMIT_TTL_SECONDS=86400

# --- Content cache ---------------------------------------------------------
# TTL for a cached summary keyed by (user_id, sha256(content)).
CACHE_TTL_SECONDS=3600
# TTL on the "identical content already in flight" guard key.
INFLIGHT_TTL_SECONDS=300

# --- Simulated processing --------------------------------------------------
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=30
# Fraction of jobs that fail on purpose, to exercise error handling.
FAILURE_RATE=0.1

# --- Worker ----------------------------------------------------------------
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=60
# Documents processed concurrently inside ONE worker process (asyncio).
# Scale processes with `docker compose up --scale worker=3` for parallelism.
WORKER_CONCURRENCY=10
# How long the worker blocks waiting for new work on each read.
STREAM_BLOCK_SECONDS=5
# A claimed document whose lease expires is assumed abandoned and requeued.
LEASE_SECONDS=120
SWEEPER_INTERVAL_SECONDS=15
# A queued document untouched for this long is re-enqueued (lost stream entry).
STALE_QUEUED_SECONDS=120

# --- Input validation ------------------------------------------------------
MAX_CONTENT_LENGTH=100000
MAX_TITLE_LENGTH=300

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- UI --------------------------------------------------------------------
# Host port the Next.js dashboard is exposed on. Change if 3000 is taken.
UI_PORT=3000
